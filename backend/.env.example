# Copie este arquivo para `.env` (não versionado) e preencha com valores reais
# para o seu ambiente. NUNCA commite o `.env` real nem valores reais aqui.

# ── Segredo JWT ──────────────────────────────────────────────────────────
# Obrigatório em todos os ambientes (sem valor padrão). Gere um valor forte,
# por exemplo: openssl rand -base64 32
JWT_SECRET=troque_por_um_valor_secreto_gerado_localmente
JWT_EXPIRATION=86400000

# ── Banco de dados (Spring / MySQL) ─────────────────────────────────────
# Usados pelo backend para conectar ao MySQL (fora ou dentro do Docker).
DB_USERNAME=root
DB_PASSWORD=troque_esta_senha

# ── MySQL (docker-compose) ──────────────────────────────────────────────
# Usados pelo serviço "mysql" no backend/docker-compose.yml.
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_USER=finance_user
MYSQL_PASSWORD=troque_esta_senha

# ── Microserviço de Data Science (FastAPI) ──────────────────────────────
DATASCIENCE_API_URL=http://host.docker.internal:8000
DATASCIENCE_API_TOKEN=troque_por_um_token_gerado_localmente
